# Copy this to .streamlit/secrets.toml and fill in your own project values.
# NEVER commit secrets.toml to GitHub.
[supabase]
url = "https://YOUR_PROJECT.supabase.co"
anon_key = "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Optional, for later AI tutor implementation:
# [ai]
# provider = "openai"
# api_key = ""
# model = ""

# Optional Phase 4 AI tutor. Never commit real credentials.
# Set provider to "openai" or "anthropic" and choose a model available to your account.
# [ai]
# provider = "openai"
# api_key = "YOUR_PROVIDER_API_KEY"
# model = "YOUR_MODEL_ID"
# daily_limit = 10
